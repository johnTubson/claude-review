{
  "name": "claude-review",
  "displayName": "Claude Review",
  "description": "Cursor-style review of the edits Claude Code makes: keep or undo each change, file, turn, session or everything, in VS Code's own diff editors.",
  "version": "1.0.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "contribEditorContentMenu",
    "contribDiffEditorGutterToolBarMenus"
  ],
  "contributes": {
    "configuration": {
      "title": "Claude Review",
      "properties": {
        "claudeReview.openFilesAs": {
          "type": "string",
          "enum": [
            "inlineDiff",
            "file"
          ],
          "enumDescriptions": [
            "VS Code's inline diff: removed lines drawn natively, Keep / Undo in the gutter",
            "The file itself, with highlighted changes; \u2325D flips to the diff"
          ],
          "default": "inlineDiff",
          "description": "How clicking a changed file opens it."
        },
        "claudeReview.groupBy": {
          "type": "string",
          "enum": [
            "files",
            "folders",
            "turns",
            "sessions"
          ],
          "default": "files",
          "description": "How the Changes view groups files."
        },
        "claudeReview.quickDiff": {
          "type": "boolean",
          "default": true,
          "description": "Gutter bars for Claude's changes, with VS Code's own peek and revert."
        },
        "claudeReview.codeLens": {
          "type": "boolean",
          "default": false,
          "description": "Show Keep / Undo above each change."
        },
        "claudeReview.decorations.addedLines": {
          "type": "boolean",
          "default": true,
          "description": "Highlight lines Claude added in plain editors."
        },
        "claudeReview.decorations.removedMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Mark where Claude removed lines in plain editors."
        },
        "claudeReview.followEdits": {
          "type": "string",
          "enum": [
            "off",
            "openDiff"
          ],
          "default": "off",
          "description": "Open each file Claude edits in its review diff, as a preview tab."
        },
        "claudeReview.confirmUndoAll": {
          "type": "boolean",
          "default": true,
          "description": "Ask before undoing every change."
        },
        "claudeReview.confirmUndoSession": {
          "type": "boolean",
          "default": true,
          "description": "Ask before undoing a whole session."
        },
        "claudeReview.maxDiffBytes": {
          "type": "number",
          "default": 4194304,
          "description": "Files larger than this are listed as too large and never read for counts or decorations."
        },
        "claudeReview.dataDir": {
          "type": "string",
          "default": "",
          "description": "Where the ledgers are kept, shared with the session-review mod. Empty means ~/.claude/claude-review/v2."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeReview",
          "title": "Claude Review",
          "icon": "media/review.svg"
        }
      ]
    },
    "views": {
      "claudeReview": [
        {
          "id": "claudeReview.changes",
          "name": "Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeReview.changes",
        "contents": "No changes from Claude to review in this workspace.\n\nEdits Claude Code makes are recorded by the session-review mod and show up here as they happen."
      }
    ],
    "submenus": [
      {
        "id": "claudeReview.groupBy",
        "label": "Group By",
        "icon": "$(list-tree)"
      }
    ],
    "commands": [
      {
        "command": "claudeReview.focus",
        "title": "Show Changes",
        "category": "Claude Review"
      },
      {
        "command": "claudeReview.reviewAll",
        "title": "Review All Changes",
        "category": "Claude Review",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeReview.refresh",
        "title": "Refresh",
        "category": "Claude Review",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeReview.groupByFiles",
        "title": "Group by Files",
        "category": "Claude Review",
        "icon": "$(list-flat)"
      },
      {
        "command": "claudeReview.groupByFolders",
        "title": "Group by Folders",
        "category": "Claude Review",
        "icon": "$(folder)"
      },
      {
        "command": "claudeReview.groupByTurns",
        "title": "Group by Turns",
        "category": "Claude Review",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeReview.groupBySessions",
        "title": "Group by Sessions",
        "category": "Claude Review",
        "icon": "$(history)"
      },
      {
        "command": "claudeReview.keepHunk",
        "title": "Keep Change",
        "category": "Claude Review",
        "icon": "$(check)"
      },
      {
        "command": "claudeReview.undoHunk",
        "title": "Undo Change",
        "category": "Claude Review",
        "icon": "$(discard)"
      },
      {
        "command": "claudeReview.keepFile",
        "title": "Keep File",
        "category": "Claude Review",
        "icon": "$(check)"
      },
      {
        "command": "claudeReview.undoFile",
        "title": "Undo File",
        "category": "Claude Review",
        "icon": "$(discard)"
      },
      {
        "command": "claudeReview.keepMapping",
        "title": "Keep Change",
        "category": "Claude Review",
        "icon": "$(check)"
      },
      {
        "command": "claudeReview.undoMapping",
        "title": "Undo Change",
        "category": "Claude Review",
        "icon": "$(discard)"
      },
      {
        "command": "claudeReview.keepTurn",
        "title": "Keep Turn",
        "category": "Claude Review",
        "icon": "$(check)"
      },
      {
        "command": "claudeReview.undoTurn",
        "title": "Undo Turn",
        "category": "Claude Review",
        "icon": "$(discard)"
      },
      {
        "command": "claudeReview.keepSession",
        "title": "Keep Session",
        "category": "Claude Review",
        "icon": "$(check)"
      },
      {
        "command": "claudeReview.undoSession",
        "title": "Undo Session",
        "category": "Claude Review",
        "icon": "$(discard)"
      },
      {
        "command": "claudeReview.keepAll",
        "title": "Keep All",
        "category": "Claude Review",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeReview.undoAll",
        "title": "Undo All",
        "category": "Claude Review",
        "icon": "$(discard)"
      },
      {
        "command": "claudeReview.revertLastKeep",
        "title": "Revert Last Keep",
        "category": "Claude Review"
      },
      {
        "command": "claudeReview.nextHunk",
        "title": "Next Change",
        "category": "Claude Review",
        "icon": "$(chevron-down)"
      },
      {
        "command": "claudeReview.prevHunk",
        "title": "Previous Change",
        "category": "Claude Review",
        "icon": "$(chevron-up)"
      },
      {
        "command": "claudeReview.nextFile",
        "title": "Next File",
        "category": "Claude Review",
        "icon": "$(arrow-right)"
      },
      {
        "command": "claudeReview.prevFile",
        "title": "Previous File",
        "category": "Claude Review",
        "icon": "$(arrow-left)"
      },
      {
        "command": "claudeReview.toggleDiff",
        "title": "Toggle Inline Diff",
        "category": "Claude Review",
        "icon": "$(diff)"
      },
      {
        "command": "claudeReview.openDiff",
        "title": "Open Diff",
        "category": "Claude Review",
        "icon": "$(diff)"
      },
      {
        "command": "claudeReview.openFile",
        "title": "Open File",
        "category": "Claude Review",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeReview.openTurnDiff",
        "title": "Show What This Turn Changed",
        "category": "Claude Review",
        "icon": "$(git-compare)"
      },
      {
        "command": "claudeReview.reviewTurn",
        "title": "Review Turn",
        "category": "Claude Review",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeReview.reviewSession",
        "title": "Review Session",
        "category": "Claude Review",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeReview.importOldSessions",
        "title": "Import Old Sessions",
        "category": "Claude Review"
      },
      {
        "command": "claudeReview.cleanUpStorage",
        "title": "Clean Up Old Storage",
        "category": "Claude Review"
      },
      {
        "command": "claudeReview.showStats",
        "title": "Show Performance Stats",
        "category": "Claude Review"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeReview.reviewAll",
          "when": "view == claudeReview.changes && claudeReview.hasChanges",
          "group": "navigation@0"
        },
        {
          "command": "claudeReview.keepAll",
          "when": "view == claudeReview.changes && claudeReview.hasChanges",
          "group": "navigation@1"
        },
        {
          "command": "claudeReview.undoAll",
          "when": "view == claudeReview.changes && claudeReview.hasChanges",
          "group": "navigation@2"
        },
        {
          "submenu": "claudeReview.groupBy",
          "when": "view == claudeReview.changes",
          "group": "navigation@3"
        },
        {
          "command": "claudeReview.refresh",
          "when": "view == claudeReview.changes",
          "group": "navigation@4"
        }
      ],
      "claudeReview.groupBy": [
        {
          "command": "claudeReview.groupByFiles",
          "group": "1@1"
        },
        {
          "command": "claudeReview.groupByFolders",
          "group": "1@2"
        },
        {
          "command": "claudeReview.groupByTurns",
          "group": "1@3"
        },
        {
          "command": "claudeReview.groupBySessions",
          "group": "1@4"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeReview.openDiff",
          "when": "view == claudeReview.changes && viewItem =~ /^crFile/",
          "group": "inline@1"
        },
        {
          "command": "claudeReview.keepFile",
          "when": "view == claudeReview.changes && viewItem == crFile",
          "group": "inline@2"
        },
        {
          "command": "claudeReview.undoFile",
          "when": "view == claudeReview.changes && viewItem == crFile",
          "group": "inline@3"
        },
        {
          "command": "claudeReview.openTurnDiff",
          "when": "view == claudeReview.changes && viewItem == crFileInTurn",
          "group": "inline@2"
        },
        {
          "command": "claudeReview.reviewTurn",
          "when": "view == claudeReview.changes && viewItem == crTurn",
          "group": "inline@1"
        },
        {
          "command": "claudeReview.keepTurn",
          "when": "view == claudeReview.changes && viewItem == crTurn",
          "group": "inline@2"
        },
        {
          "command": "claudeReview.undoTurn",
          "when": "view == claudeReview.changes && viewItem == crTurn",
          "group": "inline@3"
        },
        {
          "command": "claudeReview.reviewSession",
          "when": "view == claudeReview.changes && viewItem == crSession",
          "group": "inline@1"
        },
        {
          "command": "claudeReview.keepSession",
          "when": "view == claudeReview.changes && viewItem == crSession",
          "group": "inline@2"
        },
        {
          "command": "claudeReview.undoSession",
          "when": "view == claudeReview.changes && viewItem == crSession",
          "group": "inline@3"
        }
      ],
      "editor/title": [
        {
          "command": "claudeReview.prevFile",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths",
          "group": "navigation@91"
        },
        {
          "command": "claudeReview.nextFile",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths",
          "group": "navigation@92"
        },
        {
          "command": "claudeReview.toggleDiff",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths",
          "group": "navigation@93"
        },
        {
          "command": "claudeReview.undoFile",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths",
          "group": "navigation@94"
        },
        {
          "command": "claudeReview.keepFile",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths",
          "group": "navigation@95"
        }
      ],
      "editor/content": [
        {
          "command": "claudeReview.keepHunk",
          "group": "1_change@1",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        },
        {
          "command": "claudeReview.undoHunk",
          "group": "1_change@2",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        },
        {
          "command": "claudeReview.prevHunk",
          "group": "2_step@1",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        },
        {
          "command": "claudeReview.nextHunk",
          "group": "2_step@2",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        },
        {
          "command": "claudeReview.prevFile",
          "group": "3_file@1",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        },
        {
          "command": "claudeReview.nextFile",
          "group": "3_file@2",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        },
        {
          "command": "claudeReview.undoFile",
          "group": "4_file@1",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        },
        {
          "command": "claudeReview.keepFile",
          "group": "4_file@2",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        },
        {
          "command": "claudeReview.toggleDiff",
          "group": "5_view@1",
          "when": "resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
        }
      ],
      "diffEditor/gutter/hunk": [
        {
          "command": "claudeReview.keepMapping",
          "group": "primary@1",
          "when": "diffEditorOriginalUri =~ /^claude-base:/"
        },
        {
          "command": "claudeReview.undoMapping",
          "group": "primary@2",
          "when": "diffEditorOriginalUri =~ /^claude-base:/"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeReview.keepMapping",
          "when": "false"
        },
        {
          "command": "claudeReview.undoMapping",
          "when": "false"
        },
        {
          "command": "claudeReview.openFile",
          "when": "false"
        },
        {
          "command": "claudeReview.openTurnDiff",
          "when": "false"
        },
        {
          "command": "claudeReview.keepTurn",
          "when": "false"
        },
        {
          "command": "claudeReview.undoTurn",
          "when": "false"
        },
        {
          "command": "claudeReview.keepSession",
          "when": "false"
        },
        {
          "command": "claudeReview.undoSession",
          "when": "false"
        },
        {
          "command": "claudeReview.reviewTurn",
          "when": "false"
        },
        {
          "command": "claudeReview.reviewSession",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "claudeReview.keepHunk",
        "key": "alt+y",
        "when": "editorTextFocus && claudeReview.hunkAtCursor"
      },
      {
        "command": "claudeReview.undoHunk",
        "key": "alt+n",
        "when": "editorTextFocus && claudeReview.hunkAtCursor"
      },
      {
        "command": "claudeReview.keepFile",
        "key": "alt+shift+y",
        "when": "editorTextFocus && resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
      },
      {
        "command": "claudeReview.undoFile",
        "key": "alt+shift+n",
        "when": "editorTextFocus && resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
      },
      {
        "command": "claudeReview.nextHunk",
        "key": "alt+]",
        "when": "claudeReview.hasChanges"
      },
      {
        "command": "claudeReview.prevHunk",
        "key": "alt+[",
        "when": "claudeReview.hasChanges"
      },
      {
        "command": "claudeReview.toggleDiff",
        "key": "alt+d",
        "when": "editorTextFocus && resourceScheme == file && resourcePath in claudeReview.reviewedPaths"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node esbuild.mjs --unit && node --test --test-reporter=dot \"dist-test/unit/*.test.js\"",
    "test:integration": "node esbuild.mjs --tests && node dist-test/runIntegration.js",
    "test": "npm run test:unit && npm run test:integration",
    "package": "node esbuild.mjs && vsce package --no-dependencies --allow-missing-repository --skip-license -o claude-review.vsix",
    "install-local": "npm run package && code --install-extension claude-review.vsix --force"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "3.2.1"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
